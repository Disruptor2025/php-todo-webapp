# Copy to .env and fill in. Never commit .env.

# Supabase (Project settings -> API). The service role key is SECRET: server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Google Places API (New) key (Google Cloud console -> APIs & Services -> Credentials)
GOOGLE_PLACES_API_KEY=

# Cost estimates used for approval requests (USD). Check current Google/Anthropic pricing.
PLACES_COST_PER_REQUEST_USD=0.035
ENRICH_COST_PER_LEAD_USD=0.03

# Website that is allowed to call the API (comma-separated), and where form posts redirect
CORS_ORIGINS=http://localhost:4321
SITE_URL=http://localhost:4321
