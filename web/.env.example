# Prezence website settings.
# NOTE: anything starting with PUBLIC_ is baked into the public HTML/JS.
# Never put secrets (API keys, passwords) in this file.

# The live URL of the website (used for SEO: canonical links + sitemap)
PUBLIC_SITE_URL=https://prezence.example

# Your FastAPI backend. The preview form posts to $PUBLIC_API_URL/leads/inbound
# and the chat widget talks to $PUBLIC_API_URL/receptionist/chat
PUBLIC_API_URL=https://api.prezence.example

# Phone number of the demo AI receptionist (fictional business). Leave empty to hide the "Call" button.
PUBLIC_DEMO_PHONE=

# Contact email shown in the footer and legal pages
PUBLIC_CONTACT_EMAIL=hello@prezence.example
