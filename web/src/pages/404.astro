---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="container-page py-24 text-center">
    <h1 class="text-4xl font-extrabold">Sorry, we can't find that page</h1>
    <p class="mt-4 text-lg text-ink-700">It may have moved. Try the home page instead.</p>
    <a href="/" class="btn-primary mt-8">Go to the home page</a>
  </section>
</Base>
