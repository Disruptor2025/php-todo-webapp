---
import Base from "../layouts/Base.astro";
import PricingCards from "../components/PricingCards.astro";
import LiveDemo from "../components/LiveDemo.astro";
import Faq from "../components/Faq.astro";
import Results from "../components/Results.astro";
import CtaBand from "../components/CtaBand.astro";
import site from "../data/site.json";

const steps = [
  { title: "Tell us about your business", text: "Fill in a short form. It takes two minutes. No tech knowledge needed." },
  { title: "See your free preview", text: "We build a preview of your new website in a few days. Ask for any changes." },
  { title: "Go live and get calls", text: "We set up your website, web address and receptionist. You get on with your work." },
];
---
<Base title={site.name} description={site.description}>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-16 sm:py-24">
    <div class="container-page text-center">
      <p class="font-semibold text-brand-700">For trades, salons, clinics and restaurants</p>
      <h1 class="mx-auto mt-3 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-6xl">
        Get found online. Never miss a call again.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-700 sm:text-xl">
        We build your website, answer your phone with a friendly AI receptionist, and keep your Google profile busy, so new customers can find you and reach you.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/preview" class="btn-primary text-lg">Get a free website preview</a>
        <a href="#demo" class="btn-secondary text-lg">Try the AI receptionist</a>
      </div>
      <p class="mt-4 text-sm text-ink-500">Free preview. No card needed. No long contracts.</p>
    </div>
  </section>

  <!-- Plans -->
  <section id="plans" class="py-16">
    <div class="container-page">
      <h2 class="section-title text-center">Everything you need, done for you</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-lg text-ink-700">Pick a plan. Change or cancel any time.</p>
      <div class="mt-10"><PricingCards /></div>
      <p class="mt-6 text-center"><a href="/pricing" class="font-semibold text-brand-700 underline">Compare plans, one-time option and add-ons</a></p>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="bg-slate-50 py-16">
    <div class="container-page">
      <h2 class="section-title text-center">How it works</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {steps.map((s, i) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-600 font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-bold">{s.title}</h3>
            <p class="mt-2 text-ink-700">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <LiveDemo />
  <Results />

  <!-- FAQ -->
  <section id="faq" class="py-16">
    <div class="container-page">
      <h2 class="section-title mb-10 text-center">Questions we get asked</h2>
      <Faq />
    </div>
  </section>

  <CtaBand />
</Base>
