---
import site from "../data/site.json";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Main">
    <a href="/" class="flex items-center gap-2 text-xl font-bold text-ink-900">
      <img src="/logo.svg" alt="" width="28" height="28" />
      Prezence
    </a>
    <div class="flex items-center gap-1 sm:gap-4">
      <ul class="hidden items-center gap-6 sm:flex">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} class="font-medium text-ink-700 hover:text-brand-600" aria-current={path === item.href ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/preview" class="btn-primary px-4 py-2 text-sm">Free preview</a>
    </div>
  </nav>
  <!-- On phones the links sit in a simple row under the logo (no hamburger menu needed). -->
  <ul class="container-page flex gap-5 pb-2 text-sm sm:hidden">
    {site.nav.map((item) => (
      <li><a href={item.href} class="font-medium text-ink-700" aria-current={path === item.href ? "page" : undefined}>{item.label}</a></li>
    ))}
  </ul>
</header>
